#!/bin/sh
# MIDI (YNDX-00054) guest bootstrap: Alpine arm64 + real rootfs on /dev/vda.
set -eu
mkdir -p /tmp /run /midi /mnt/leds
mount -t tmpfs -o mode=1777 tmpfs /tmp
mount -t tmpfs tmpfs /run
mkdir -p /dev/shm /dev/pts
mount -t tmpfs -o mode=1777 tmpfs /dev/shm
mount -t devpts devpts /dev/pts
modprobe virtio_blk
modprobe virtio_net
modprobe ext4
modprobe virtio_snd || true
modprobe bluetooth || true
modprobe hci_vhci || true
if [ -f /opt/midi/host_epoch ]; then
    date -u -s "@$(cat /opt/midi/host_epoch)"
fi

mount /dev/vda /midi
mkdir -p /midi/data /midi/proc /midi/sys /midi/tmp /midi/run /midi/dev /midi/ota
if [ -b /dev/vdb ]; then
    mount /dev/vdb /midi/data
fi
# /bkupgrade is a symlink to /ota on the device
mkdir -p /midi/ota/data /midi/ota/quasar
mount -t tmpfs -o mode=1777 tmpfs /midi/ota

mount -t proc proc /midi/proc
if [ -f /etc/fake_cmdline ]; then
    mount --bind /etc/fake_cmdline /midi/proc/cmdline
fi
mount --rbind /dev /midi/dev
mount -t tmpfs -o mode=1777 tmpfs /midi/tmp
mount -t tmpfs tmpfs /midi/run

# Real sysfs everywhere except the LED class, which is emulated below.
mount -t tmpfs tmpfs /midi/sys
for entry in /sys/*; do
    name=${entry##*/}
    [ "$name" = class ] && continue
    [ -d "$entry" ] || continue
    mkdir -p "/midi/sys/$name"
    mount --bind "$entry" "/midi/sys/$name"
done
mkdir -p /midi/sys/class
for entry in /sys/class/*; do
    name=${entry##*/}
    mkdir -p "/midi/sys/class/$name"
    mount --bind "$entry" "/midi/sys/class/$name"
done

ip link set lo up
network_if=eth0
for device in /sys/class/net/*; do
    case "$(cat "$device/address" 2>/dev/null)" in
        52:54:00:4d:32:01) network_if=${device##*/} ;;
    esac
done
ip link set "$network_if" name wlan0
ip link set wlan0 up
ip addr add 10.0.2.15/24 dev wlan0
ip route add default via 10.0.2.2
printf 'nameserver 10.0.2.3\n' >/etc/resolv.conf
printf 'nameserver 10.0.2.3\n' >/midi/etc/resolv.conf
echo 1 >/proc/sys/vm/overcommit_memory

cp /opt/midi/asound.conf /midi/etc/asound.conf

# D-Bus is required by quasar daemons.
export LD_LIBRARY_PATH=/lib:/usr/lib
chroot /midi /bin/sh -c 'mkdir -p /tmp/dbus /var/run/dbus /var/lib/dbus; dbus-uuidgen --ensure 2>/dev/null; dbus-daemon --system --fork 2>/dev/null' || true

mkdir -p /midi/data/quasar/logs /midi/data/quasar/daemons_logs /midi/data/quasar/data
chmod 777 /midi/data/quasar /midi/data/quasar/logs || true

echo 'MIDI: rootfs mounted; starting Quasar'
chroot /midi /system/vendor/quasar/onboot.sh start >/midi/tmp/midi-onboot.log 2>&1 &
echo $! >/run/midi-onboot.pid

# Service detection reads /proc/<pid>/cmdline instead of `ps | grep`:
# the grep process carries the pattern in its own argv, so a pipeline found
# itself and the panel reported services that were not actually running.
maind_runs() {
  for file in /proc/[0-9]*/cmdline; do
    [ -r "$file" ] || continue
    cmd=$(tr '\000' ' ' <"$file" 2>/dev/null) || continue
    case "$cmd" in
      *"maind $1 "*) return 0 ;;
    esac
  done
  return 1
}

# firmware status for the panel (same JSON shape as Mini 2) over TCP 19095
(
  while true; do
    plat=false; if maind_runs --platformd; then plat=true; fi
    med=false; if maind_runs --mediad; then med=true; fi
    tel=false; if maind_runs --telemetry; then tel=true; fi
    snd=false; if [ -c /dev/snd/pcmC0D0p ]; then snd=true; fi
    bt=false; if [ -e /sys/class/bluetooth/hci0 ]; then bt=true; fi
    net=false; if ip route 2>/dev/null | grep -q '^default '; then net=true; fi
    {
      printf 'status {"source":"midi","platformd":%s,"mediad":%s,"telemetry":%s,"sound":%s,"keymaster":false,"bluetooth":%s,"network":%s,"timestamp":%s}\n' \
        "$plat" "$med" "$tel" "$snd" "$bt" "$net" "$(date +%s)"
      echo .
    } | nc 10.0.2.2 19095 2>/dev/null
    sleep 5
  done
) >/var/log/midi-status.log 2>&1 &
